#!/bin/sh
# S65netboot - PXE network boot served by the hive (netboot = yes, hive role).
#
# dnsmasq answers PXE clients as a proxy DHCP server next to the LAN's own
# router (or as the full DHCP server with dhcp_server = yes) and serves
# /run/savior/tftp over TFTP. That tree links to the boot files on the stick
# (GRUB network images from /boot/netboot, kernels from /boot/<arch>) plus a
# generated grub.cfg whose kernel command line points netbooted machines at
# this hive:
#   savior.hive=<ip>:<port> savior.hive_fingerprint=sha256:... savior.join=keyless savior.media=none
# It never contains the swarm key (DESIGN 6, 13.3): netbooted nodes join
# keyless and wait for admin approval.
#
# The work happens in a background job that waits until this machine has
# an IPv4 address and the hive has created its TLS certificate.
set -u
# shellcheck source=../../usr/libexec/savior/lib.sh
. /usr/libexec/savior/lib.sh

MEDIA=/media/savior
TFTP=$RUN_DIR/tftp
CONF=$RUN_DIR/dnsmasq.conf
SAVIOR=/usr/bin/savior

# hive_cert: print the hive certificate path (<hive_data>/tls/cert.pem).
hive_cert() {
	if [ "${SAVIOR_HIVE_DATA:-auto}" != auto ]; then
		set -- "$SAVIOR_HIVE_DATA/tls/cert.pem"
	else
		set -- /var/lib/savior/data/tls/cert.pem /var/lib/savior/data/hive/tls/cert.pem \
			/var/lib/savior/hive/tls/cert.pem /run/savior/hive/tls/cert.pem
	fi
	for c in "$@"; do
		if [ -s "$c" ]; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# serve_iface: the interface PXE is served on, with its address.
# Prints "IFACE ADDR PREFIX".
serve_iface() {
	for i in $(wired_ifaces); do
		a=$(if_ipv4 "$i")
		if [ -n "$a" ]; then
			echo "$i $a"
			return 0
		fi
	done
	return 1
}

# netboot_grub_dir: the GRUB network images (grub-mknetdir layout) on the stick.
netboot_grub_dir() {
	for d in "$MEDIA/boot/netboot/boot/grub" "$MEDIA/boot/netboot/grub" "$MEDIA/boot/netboot"; do
		if [ -d "$d/i386-pc" ] || [ -d "$d/x86_64-efi" ]; then
			echo "$d"
			return 0
		fi
	done
	return 1
}

# has_word WORD LIST: WORD is one of the blank-separated words of LIST.
has_word() {
	case " $2 " in *" $1 "*) return 0 ;; esac
	return 1
}

# write_grub_cfg ARCHES CMDLINE
write_grub_cfg() {
	arches=$1
	cmdline=$2
	cat <<EOF
# SaviorOS network boot menu, generated by S65netboot on the hive.
set timeout=5
set default=0
set savior_cmdline="$cmdline"
insmod all_video
insmod gfxterm
serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

EOF
	# Both payloads: 64-bit whenever the CPU has long mode, on every
	# platform (the x86_64 kernel has EFI_MIXED for 32-bit UEFI; DESIGN 13.1).
	if has_word x86_64 "$arches" && has_word i686 "$arches"; then
		printf '%s\n' 'if cpuid -l; then' '	set arch=x86_64' 'else' '	set arch=i686' 'fi'
	elif has_word x86_64 "$arches"; then
		echo 'set arch=x86_64'
	else
		echo 'set arch=i686'
	fi
	cat <<'EOF'

menuentry "SaviorOS $arch (network boot)" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/$arch/vmlinuz $savior_cmdline
	initrd /boot/$arch/initrd
}
menuentry "SaviorOS $arch - safe graphics (nomodeset, firmware framebuffer)" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/$arch/vmlinuz $savior_cmdline nomodeset
	initrd /boot/$arch/initrd
}
menuentry "SaviorOS $arch - safe mode (no ACPI/APIC)" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/$arch/vmlinuz $savior_cmdline noapic nolapic acpi=off irqpoll nomodeset
	initrd /boot/$arch/initrd
}
menuentry "SaviorOS $arch - text only" {
	set gfxpayload=text
	linux /boot/$arch/vmlinuz $savior_cmdline
	initrd /boot/$arch/initrd
}
menuentry "SaviorOS $arch - display only" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/$arch/vmlinuz $savior_cmdline savior.roles=display
	initrd /boot/$arch/initrd
}
menuentry "SaviorOS $arch - rescue shell on tty2, verbose boot" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/$arch/vmlinuz $savior_cmdline loglevel=7 savior.console_shell=yes
	initrd /boot/$arch/initrd
}
EOF
	if has_word x86_64 "$arches" && has_word i686 "$arches"; then
		cat <<'EOF'
menuentry "SaviorOS i686 (force 32-bit)" {
	if [ "$grub_platform" = "pc" ]; then
		set gfxpayload=1024x768x32,1024x768x16,800x600x32,800x600x16,auto
	fi
	linux /boot/i686/vmlinuz $savior_cmdline
	initrd /boot/i686/initrd
}
EOF
	fi
	cat <<'EOF'
menuentry "Boot from local disk" { exit }
menuentry "Reboot" { reboot }
menuentry "Power off" { halt }
EOF
}

# build_tree: the TFTP root. Only whitelisted directories are linked, never
# the stick root (savior.conf, boot/savior-conf.cpio hold the swarm key).
build_tree() {
	nbgrub=$(netboot_grub_dir) || {
		log "netboot: no GRUB network images in $MEDIA/boot/netboot (build the image with the netboot format)"
		return 1
	}
	rm -rf "$TFTP"
	mkdir -p "$TFTP/boot/grub"
	for e in i386-pc x86_64-efi i386-efi fonts locale; do
		[ -e "$nbgrub/$e" ] && ln -s "$nbgrub/$e" "$TFTP/boot/grub/$e"
	done
	arches=""
	for a in x86_64 i686; do
		for src in "$MEDIA/boot/$a" "$MEDIA/boot/netboot/boot/$a"; do
			if [ -f "$src/vmlinuz" ] && [ -f "$src/initrd" ]; then
				ln -s "$src" "$TFTP/boot/$a"
				arches="$arches $a"
				break
			fi
		done
	done
	if [ -z "$arches" ]; then
		log "netboot: no kernels in $MEDIA/boot"
		return 1
	fi
	echo "$arches"
}

write_dnsmasq_conf() {
	iface=$1
	addr=$2
	prefix=$3
	nbgrub=$4
	{
		echo "# generated by S65netboot"
		echo "port=0"
		echo "interface=$iface"
		# The boot files on the stick are readable by root only.
		echo "user=root"
		echo "group=root"
		echo "pid-file=$RUN_DIR/dnsmasq.pid"
		echo "dhcp-leasefile=$RUN_DIR/dnsmasq.leases"
		echo "enable-tftp"
		echo "tftp-root=$TFTP"
		if is_yes "${SAVIOR_DHCP_SERVER:-no}"; then
			# shellcheck disable=SC2046 # "FIRST LAST"
			set -- $(dhcp_range "$addr" "$prefix")
			echo "dhcp-range=$1,$2,$(prefix2mask "$prefix"),12h"
			[ -n "${SAVIOR_GATEWAY:-}" ] && echo "dhcp-option=option:router,$SAVIOR_GATEWAY"
			[ -n "${SAVIOR_DNS:-}" ] && echo "dhcp-option=option:dns-server,$(echo "$SAVIOR_DNS" | tr '\n' ',' | sed 's/,$//')"
		else
			# Proxy DHCP: the LAN's router keeps handing out addresses.
			echo "dhcp-range=$(network_of "$addr" "$prefix"),proxy,$(prefix2mask "$prefix")"
		fi
		[ -e "$nbgrub/i386-pc/core.0" ] &&
			echo 'pxe-service=x86PC,"SaviorOS",boot/grub/i386-pc/core.0'
		if [ -e "$nbgrub/x86_64-efi/core.efi" ]; then
			echo 'pxe-service=BC_EFI,"SaviorOS",boot/grub/x86_64-efi/core.efi'
			echo 'pxe-service=X86-64_EFI,"SaviorOS",boot/grub/x86_64-efi/core.efi'
		fi
		[ -e "$nbgrub/i386-efi/core.efi" ] &&
			echo 'pxe-service=IA32_EFI,"SaviorOS",boot/grub/i386-efi/core.efi'
		return 0
	} >"$CONF"
}

# generate IFACE ADDR PREFIX CERT: build the TFTP tree, grub.cfg and
# dnsmasq.conf (also usable by hand: /etc/init.d/S65netboot generate ...).
generate() {
	iface=$1
	addr=$2
	prefix=$3
	fp=$("$SAVIOR" storage fingerprint "$4") || {
		log "netboot: cannot read the hive certificate $4"
		return 1
	}
	port=${SAVIOR_HIVE_LISTEN:-:7700}
	port=${port##*:}
	arches=$(build_tree) || return 1
	cmdline="consoleblank=0 quiet loglevel=3 console=ttyS0,115200 console=tty0"
	cmdline="$cmdline savior.hive=$addr:$port savior.hive_fingerprint=$fp savior.join=keyless savior.media=none"
	write_grub_cfg "$arches" "$cmdline" >"$TFTP/boot/grub/grub.cfg"
	write_dnsmasq_conf "$iface" "$addr" "$prefix" "$(netboot_grub_dir)"
	log "netboot: serving PXE on $iface ($addr) for$arches, hive $addr:$port"
}

# serve: background job; waits for an address and the hive certificate,
# then execs dnsmasq in the foreground so the job's pidfile tracks it.
serve() {
	load_env
	n=0
	while :; do
		if net=$(serve_iface) && cert=$(hive_cert); then
			break
		fi
		[ "$n" -eq 60 ] && log "netboot: waiting for an IPv4 address and the hive certificate"
		sleep 2
		n=$((n + 1))
	done
	# shellcheck disable=SC2086 # "IFACE ADDR PREFIX"
	generate $net "$cert" || return 1
	exec dnsmasq -k -C "$CONF"
}

start() {
	load_env
	is_yes "${SAVIOR_NETBOOT:-no}" || return 0
	if [ "${SAVIOR_ROLE_HIVE:-no}" != yes ]; then
		say "netboot = yes needs the hive role (roles = hive); not serving PXE"
		return 0
	fi
	if ! have dnsmasq; then
		say "netboot = yes but this image has no dnsmasq"
		return 0
	fi
	if [ ! -d "$MEDIA/boot" ]; then
		say "netboot = yes needs the SaviorOS stick (the boot files come from it); not serving PXE"
		return 0
	fi
	daemonize netboot /etc/init.d/S65netboot serve
}

stop() {
	stop_job netboot
	rm -rf "$TFTP"
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
serve) serve ;;
generate)
	load_env
	generate "${2:?iface}" "${3:?address}" "${4:?prefix}" "${5:?cert.pem}" || exit 1
	;;
*)
	echo "usage: $0 start|stop|restart" >&2
	exit 2
	;;
esac
exit 0
