#!/bin/sh
# S10system - hostname, time zone, kernel hardening sysctls (DESIGN 6.5),
# cpufreq governor and zram swap.
set -u
# shellcheck source=../../usr/libexec/savior/lib.sh
. /usr/libexec/savior/lib.sh

SYSCTL_CONF=/etc/sysctl.d/savior.conf

set_hostname() {
	# The node agent may later use the hive-assigned name.
	name=${SAVIOR_NAME:-}
	[ -n "$name" ] || name=savior
	hostname "$name" 2>/dev/null || log "cannot set hostname $name"
	echo "$name" >/etc/hostname
	chmod 0644 /etc/hostname
}

set_timezone() {
	# Go has the zone database built in; savior gets TZ from the run
	# script. /etc/TZ is for reference and the shell.
	echo "${SAVIOR_TIMEZONE:-UTC}" >/etc/TZ
	chmod 0644 /etc/TZ
}

# apply_sysctls FILE: "key = value" lines, applied one by one so a key the
# kernel doesn't have (e.g. user.max_user_namespaces without USER_NS) doesn't
# stop the others.
apply_sysctls() {
	[ -r "$1" ] || return 0
	while read -r key eq value; do
		case "$key" in '' | '#'* | ';'*) continue ;; esac
		[ "$eq" = "=" ] || continue
		path=/proc/sys/$(echo "$key" | tr . /)
		if [ -w "$path" ]; then
			echo "$value" >"$path" 2>/dev/null || log "sysctl $key = $value failed"
		else
			log "sysctl $key: not supported by this kernel"
		fi
	done <"$1"
}

set_governor() {
	want=${SAVIOR_CPU_GOVERNOR:-auto}
	set_any=no
	for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
		/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
		[ -w "$f" ] || continue
		avail=$(cat "${f%/*}/scaling_available_governors" 2>/dev/null)
		gov=""
		if [ "$want" = auto ]; then
			for g in schedutil ondemand; do
				case " $avail " in *" $g "*)
					gov=$g
					break
					;;
				esac
			done
		else
			case " $avail " in
			*" $want "*) gov=$want ;;
			*) log "cpufreq governor $want not available (have: $avail)" ;;
			esac
		fi
		if [ -n "$gov" ] && echo "$gov" >"$f" 2>/dev/null; then
			set_any=$gov
		fi
	done
	[ "$set_any" = no ] || log "cpufreq governor: $set_any"
}

# setup_zram: compressed swap in RAM, 50% of MemTotal, lz4 else zstd.
setup_zram() {
	grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null && return 0
	[ -e /sys/block/zram0 ] || modprobe -q zram 2>/dev/null
	if [ ! -e /sys/block/zram0 ] || [ ! -b /dev/zram0 ]; then
		log "no zram device: running without swap"
		return 0
	fi
	have mkswap && have swapon || return 0
	z=/sys/block/zram0
	if [ "$(cat "$z/disksize" 2>/dev/null)" != 0 ]; then
		echo 1 >"$z/reset" 2>/dev/null
	fi
	algs=$(cat "$z/comp_algorithm" 2>/dev/null)
	for a in lz4 zstd; do
		case " $algs " in
		*" $a "* | *"[$a]"*)
			echo "$a" >"$z/comp_algorithm" 2>/dev/null && break
			;;
		esac
	done
	mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	if ! echo "$((mem_kb / 2))K" >"$z/disksize" 2>/dev/null; then
		log "zram: cannot set the size"
		return 0
	fi
	if mkswap /dev/zram0 >/dev/null 2>&1 &&
		{ swapon -p 100 /dev/zram0 2>/dev/null || swapon /dev/zram0; }; then
		log "zram swap: $((mem_kb / 2048)) MiB ($(sed -n 's/.*\[\(.*\)\].*/\1/p' "$z/comp_algorithm"))"
	else
		log "zram swap failed"
	fi
}

stop_zram() {
	if grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null; then
		swapoff /dev/zram0 2>/dev/null && echo 1 >/sys/block/zram0/reset 2>/dev/null
	fi
}

case "${1:-}" in
start | restart)
	load_env
	set_hostname
	set_timezone
	apply_sysctls "$SYSCTL_CONF"
	set_governor
	setup_zram
	;;
stop) stop_zram ;;
*)
	echo "usage: $0 start|stop|restart" >&2
	exit 2
	;;
esac
exit 0
