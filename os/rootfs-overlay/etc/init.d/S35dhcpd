#!/bin/sh
# S35dhcpd - a small DHCP server (udhcpd) on the first wired interface when
# dhcp_server = yes (needs net = static). With netboot = yes, dnsmasq
# (S65netboot) serves DHCP and PXE instead.
set -u
# shellcheck source=../../usr/libexec/savior/lib.sh
. /usr/libexec/savior/lib.sh

CONF=$RUN_DIR/udhcpd.conf
LEASES=$RUN_DIR/udhcpd.leases
PIDFILE=$RUN_DIR/udhcpd.pid

start() {
	load_env
	is_yes "${SAVIOR_DHCP_SERVER:-no}" || return 0
	if is_yes "${SAVIOR_NETBOOT:-no}"; then
		log "dhcpd: netboot = yes, dnsmasq serves DHCP"
		return 0
	fi
	if [ "${SAVIOR_NET:-dhcp}" != static ] || [ -z "${SAVIOR_IP:-}" ]; then
		say "dhcp_server = yes needs net = static and ip = A.B.C.D/NN; not serving DHCP"
		return 0
	fi
	if ! have udhcpd; then
		say "dhcp_server = yes but this image has no udhcpd"
		return 0
	fi
	running udhcpd && return 0
	iface=$(first_wired)
	if [ -z "$iface" ]; then
		say "dhcp_server = yes but there is no wired interface"
		return 0
	fi
	addr=${SAVIOR_IP%/*}
	prefix=${SAVIOR_IP#*/}
	# shellcheck disable=SC2046 # "FIRST LAST"
	set -- $(dhcp_range "$addr" "$prefix")
	first=$1
	last=$2
	{
		echo "# generated by S35dhcpd from savior.conf"
		echo "interface $iface"
		echo "start $first"
		echo "end $last"
		echo "max_leases $(($(ip2int "$last") - $(ip2int "$first") + 1))"
		echo "lease_file $LEASES"
		echo "pidfile $PIDFILE"
		echo "option subnet $(prefix2mask "$prefix")"
		[ -n "${SAVIOR_GATEWAY:-}" ] && echo "option router $SAVIOR_GATEWAY"
		# shellcheck disable=SC2086 # SAVIOR_DNS: one server per line
		[ -n "${SAVIOR_DNS:-}" ] && echo "option dns" $SAVIOR_DNS
		echo "option lease 86400"
	} >"$CONF"
	[ -e "$LEASES" ] || : >"$LEASES"
	if udhcpd -S "$CONF" >/dev/null 2>&1; then
		log "dhcpd: serving $first-$last on $iface"
	else
		say "dhcpd: udhcpd failed to start"
	fi
}

stop() {
	stop_job udhcpd
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
*)
	echo "usage: $0 start|stop|restart" >&2
	exit 2
	;;
esac
exit 0
