#!/bin/sh
# S30network - loopback, wired interfaces (DHCP or static), Wi-Fi and the
# IPv4 link-local fallback (DESIGN 5.3 net, ip, gateway, dns, wifi_*).
#
#   net = dhcp    udhcpc on every wired interface, in the background (a
#                 cable plugged in later still gets a lease: udhcpc keeps
#                 retrying). After 30 s without a lease, zcip assigns a
#                 169.254/16 address when the image has it.
#   net = static  ip/gateway/dns on the first wired interface (or on the
#                 Wi-Fi interface when there is no wired one). Further wired
#                 interfaces use DHCP, e.g. a hive's second NIC to an uplink
#                 network (the static gateway and DNS keep precedence).
#   net = off     loopback only.
#   wifi_ssid     wpa_supplicant + DHCP (or static) on the first wireless
#                 interface, in the background (drivers may still be loading
#                 firmware).
set -u
# shellcheck source=../../usr/libexec/savior/lib.sh
. /usr/libexec/savior/lib.sh

SCRIPT=/etc/init.d/S30network
DHCP_SCRIPT=$LIBEXEC/udhcpc.script
ZCIP_SCRIPT=$LIBEXEC/zcip.script
WPA_CONF=$RUN_DIR/wpa_supplicant.conf

# start_dhcp IFACE: udhcpc in the background (it tries for ~12 s, then
# daemonizes and keeps retrying).
start_dhcp() {
	iface=$1
	pf=$RUN_DIR/udhcpc.$iface.pid
	if [ -f "$pf" ] && kill -0 "$(cat "$pf")" 2>/dev/null; then
		return 0
	fi
	set -- -b -S -R -i "$iface" -p "$pf" -s "$DHCP_SCRIPT" -t 4 -T 3 -A 15
	if [ -n "${SAVIOR_NAME:-}" ]; then
		set -- "$@" -x "hostname:$SAVIOR_NAME"
	fi
	udhcpc "$@" </dev/null >/dev/null 2>&1 &
	log "dhcp: udhcpc started on $iface"
}

# static_on IFACE: apply ip/gateway/dns.
static_on() {
	if [ -z "${SAVIOR_IP:-}" ]; then
		say "net = static but no ip is set; configure ip = A.B.C.D/NN"
		return 1
	fi
	ip link set "$1" up
	ip addr add "$SAVIOR_IP" dev "$1" 2>/dev/null
	if [ -n "${SAVIOR_GATEWAY:-}" ]; then
		ip route replace default via "$SAVIOR_GATEWAY" dev "$1" ||
			log "static: cannot add the default route via $SAVIOR_GATEWAY"
	fi
	# SAVIOR_DNS holds one server per line.
	# shellcheck disable=SC2086 # split the list into arguments
	[ -n "${SAVIOR_DNS:-}" ] && write_resolv /etc/resolv.conf $SAVIOR_DNS
	log "static: $SAVIOR_IP on $1${SAVIOR_GATEWAY:+ via $SAVIOR_GATEWAY}"
}

rfkill_unblock() {
	for r in /sys/class/rfkill/rfkill*; do
		[ -e "$r/soft" ] || continue
		[ "$(cat "$r/type" 2>/dev/null)" = wlan ] || continue
		echo 0 >"$r/soft" 2>/dev/null
		if [ "$(cat "$r/hard" 2>/dev/null)" = 1 ]; then
			log "wifi: ${r##*/} is blocked by a hardware switch"
		fi
	done
}

# write_wpa_conf: WPA2-PSK or open network; SSID hex-encoded, PSK hashed
# with wpa_passphrase when available (passphrase via stdin, not argv).
write_wpa_conf() {
	ssid_hex=$(printf '%s' "$SAVIOR_WIFI_SSID" | od -An -v -tx1 | tr -d ' \n')
	psk_line=""
	if [ -n "${SAVIOR_WIFI_PSK:-}" ]; then
		if have wpa_passphrase; then
			hex=$(printf '%s\n' "$SAVIOR_WIFI_PSK" | wpa_passphrase "$SAVIOR_WIFI_SSID" 2>/dev/null |
				sed -n 's/^[[:space:]]*psk=\([0-9a-f]\{64\}\)$/\1/p')
			[ -n "$hex" ] && psk_line="psk=$hex"
		fi
		if [ -z "$psk_line" ]; then
			case "$SAVIOR_WIFI_PSK" in
			*'"'*)
				log "wifi: wifi_psk contains a double quote and wpa_passphrase is missing"
				return 1
				;;
			esac
			psk_line="psk=\"$SAVIOR_WIFI_PSK\""
		fi
	fi
	{
		echo "# generated by $SCRIPT from savior.conf"
		echo "ctrl_interface=/run/wpa_supplicant"
		echo "country=${SAVIOR_WIFI_COUNTRY:-US}"
		echo "ap_scan=1"
		echo "network={"
		echo "	ssid=$ssid_hex"
		echo "	scan_ssid=1"
		if [ -n "$psk_line" ]; then
			echo "	key_mgmt=WPA-PSK"
			echo "	$psk_line"
		else
			echo "	key_mgmt=NONE"
		fi
		echo "}"
	} >"$WPA_CONF.tmp" && chmod 0600 "$WPA_CONF.tmp" && mv -f "$WPA_CONF.tmp" "$WPA_CONF"
}

# wifi: background job. Waits up to 30 s for a wireless interface.
wifi() {
	load_env
	if ! have wpa_supplicant; then
		log "wifi: wifi_ssid is set but this image has no wpa_supplicant"
		return 0
	fi
	n=0
	w=$(first_wireless)
	while [ -z "$w" ] && [ "$n" -lt 30 ]; do
		sleep 1
		n=$((n + 1))
		w=$(first_wireless)
	done
	if [ -z "$w" ]; then
		log "wifi: no wireless interface (driver or firmware missing? put firmware files into /firmware on the stick)"
		return 0
	fi
	rfkill_unblock
	write_wpa_conf || return 0
	ip link set "$w" up 2>/dev/null
	pf=$RUN_DIR/wpa_supplicant.$w.pid
	if ! { [ -f "$pf" ] && kill -0 "$(cat "$pf")" 2>/dev/null; }; then
		wpa_supplicant -B -s -i "$w" -c "$WPA_CONF" -P "$pf" -D nl80211,wext >/dev/null 2>&1 ||
			wpa_supplicant -B -s -i "$w" -c "$WPA_CONF" -P "$pf" >/dev/null 2>&1 ||
			{
				log "wifi: wpa_supplicant failed on $w"
				return 0
			}
		log "wifi: joining '$SAVIOR_WIFI_SSID' on $w"
	fi
	if [ "${SAVIOR_NET:-dhcp}" = static ] && [ -z "$(first_wired)" ]; then
		static_on "$w"
	else
		start_dhcp "$w"
	fi
}

# linklocal: background job. After 30 s, give every interface with a
# carrier and no IPv4 address a 169.254/16 address (zcip).
linklocal() {
	sleep 30
	for i in $(wired_ifaces) $(wireless_ifaces); do
		[ "$(cat "/sys/class/net/$i/carrier" 2>/dev/null)" = 1 ] || continue
		[ -z "$(if_ipv4 "$i")" ] || continue
		if zcip "$i" "$ZCIP_SCRIPT" >/dev/null 2>&1; then
			log "no DHCP lease on $i: using an IPv4 link-local address"
		fi
	done
}

start() {
	load_env
	ip link set lo up 2>/dev/null || log "cannot bring up lo"
	net=${SAVIOR_NET:-dhcp}
	if [ "$net" = off ]; then
		log "network: off (net = off)"
		return 0
	fi
	wired=$(wired_ifaces)
	case "$net" in
	static)
		first=$(first_wired)
		if [ -n "$first" ]; then
			static_on "$first"
			for i in $wired; do
				[ "$i" != "$first" ] || continue
				ip link set "$i" up 2>/dev/null
				start_dhcp "$i"
			done
		elif [ -z "${SAVIOR_WIFI_SSID:-}" ]; then
			say "net = static but there is no wired interface"
		fi
		;;
	*)
		for i in $wired; do
			ip link set "$i" up 2>/dev/null
			start_dhcp "$i"
		done
		[ -n "$wired" ] || [ -n "${SAVIOR_WIFI_SSID:-}" ] ||
			say "no network interface found (driver missing?)"
		;;
	esac
	if [ -n "${SAVIOR_WIFI_SSID:-}" ]; then
		daemonize wifi "$SCRIPT" wifi
	fi
	if [ "$net" = dhcp ] && have zcip; then
		daemonize linklocal "$SCRIPT" linklocal
	fi
	return 0
}

stop() {
	stop_job linklocal
	stop_job wifi
	for pf in "$RUN_DIR"/udhcpc.*.pid "$RUN_DIR"/wpa_supplicant.*.pid; do
		[ -f "$pf" ] || continue
		kill "$(cat "$pf")" 2>/dev/null
		rm -f "$pf"
	done
	have zcip && killall zcip 2>/dev/null
	return 0
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
wifi) wifi ;;
linklocal) linklocal ;;
*)
	echo "usage: $0 start|stop|restart" >&2
	exit 2
	;;
esac
exit 0
