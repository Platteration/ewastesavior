# SaviorOS BusyBox configuration fragment, merged by Buildroot on top of its
# default package/busybox/busybox.config (BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES).
#
# Everything the rootfs-overlay init scripts and the task sandbox rely on is
# enabled explicitly here, so a change in Buildroot's default config cannot
# silently drop an applet. post-build.sh checks the resulting applet links.

# --- init, power, tty ---------------------------------------------------------
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_KILL_REMOVED=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_QUIET=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_GETTY=y
CONFIG_CTTYHACK=y
CONFIG_CHVT=y
CONFIG_OPENVT=y
CONFIG_DEALLOCVT=y
CONFIG_LOADKMAP=y
CONFIG_FBSET=y
# No setuid busybox: nothing on a node may gain privileges (DESIGN 6.5).
# CONFIG_FEATURE_SUID is not set

# --- devices and kernel modules ---------------------------------------------
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_RENAME_REGEXP=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_FEATURE_MDEV_DAEMON=y
CONFIG_UEVENT=y
CONFIG_MODPROBE=y
# CONFIG_MODPROBE_SMALL is not set
CONFIG_INSMOD=y
CONFIG_RMMOD=y
CONFIG_LSMOD=y
CONFIG_DEPMOD=y
CONFIG_MODINFO=y
CONFIG_FEATURE_MODPROBE_BLACKLIST=y
CONFIG_FEATURE_MODUTILS_ALIAS=y
CONFIG_FEATURE_MODUTILS_SYMBOLS=y
CONFIG_FEATURE_CMDLINE_MODULE_OPTIONS=y
CONFIG_DEFAULT_MODULES_DIR="/lib/modules"
CONFIG_DEFAULT_DEPMOD_FILE="modules.dep"

# --- disks and filesystems --------------------------------------------------
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_FEATURE_MOUNT_LOOP_CREATE=y
CONFIG_UMOUNT=y
CONFIG_LOSETUP=y
CONFIG_MOUNTPOINT=y
CONFIG_FINDFS=y
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FEATURE_VOLUMEID_ISO9660=y
CONFIG_FEATURE_VOLUMEID_LINUXSWAP=y
CONFIG_FEATURE_VOLUMEID_SQUASHFS=y
CONFIG_BLOCKDEV=y
CONFIG_FDISK=y
CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_MKDOSFS=y
CONFIG_MKFS_VFAT=y
CONFIG_MKE2FS=y
CONFIG_MKFS_EXT2=y
CONFIG_MKSWAP=y
CONFIG_SWAPON=y
CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_SWAPOFF=y
CONFIG_SYNC=y

# --- networking ---------------------------------------------------------------
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_FEATURE_UDHCPC_SANITIZEOPT=y
CONFIG_UDHCPD=y
CONFIG_DUMPLEASES=y
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_CONF=y
# CONFIG_FEATURE_NTPD_SERVER is not set
CONFIG_ZCIP=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_NEIGH=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_ARPING=y
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_NETSTAT=y
CONFIG_NSLOOKUP=y
CONFIG_HOSTNAME=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_NC=y
# Network services SaviorOS does not run (dropbear, dnsmasq and savior cover
# SSH, DHCP/TFTP and HTTP).
# CONFIG_TELNETD is not set
# CONFIG_HTTPD is not set
# CONFIG_FTPD is not set
# CONFIG_TFTPD is not set
# CONFIG_INETD is not set
# CONFIG_TCPSVD is not set
# CONFIG_UDPSVD is not set

# --- services and processes ---------------------------------------------------
CONFIG_START_STOP_DAEMON=y
CONFIG_FEATURE_START_STOP_DAEMON_LONG_OPTIONS=y
CONFIG_FEATURE_START_STOP_DAEMON_FANCY=y
CONFIG_SETSID=y
CONFIG_SETPRIV=y
CONFIG_NOHUP=y
CONFIG_TIMEOUT=y
CONFIG_FLOCK=y
CONFIG_NICE=y
CONFIG_RENICE=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_NPROC=y
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_FREE=y
CONFIG_UPTIME=y

# --- logging ------------------------------------------------------------------
CONFIG_LOGGER=y
CONFIG_SYSLOGD=y
CONFIG_FEATURE_ROTATE_LOGFILE=y
CONFIG_FEATURE_IPC_SYSLOG=y
CONFIG_FEATURE_IPC_SYSLOG_BUFFER_SIZE=64
CONFIG_LOGREAD=y
CONFIG_FEATURE_LOGREAD_REDUCED_LOCKING=y
CONFIG_KLOGD=y
CONFIG_DMESG=y

# --- system -------------------------------------------------------------------
CONFIG_BB_SYSCTL=y
CONFIG_HWCLOCK=y
CONFIG_DATE=y
# /dev/mem poking has no place on a node.
# CONFIG_DEVMEM is not set

# --- tools task scripts commonly use (they run /bin/sh inside the sandbox) ----
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_AWK=y
CONFIG_SED=y
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_SEQ=y
CONFIG_EXPR=y
CONFIG_BC=y
CONFIG_DC=y
CONFIG_TEST=y
CONFIG_PRINTF=y
CONFIG_ENV=y
CONFIG_STAT=y
CONFIG_REALPATH=y
CONFIG_READLINK=y
CONFIG_MKTEMP=y
CONFIG_SLEEP=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_BASE64=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_CPIO=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_XZ=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_UNZIP=y
CONFIG_VI=y
CONFIG_LESS=y
CONFIG_WHICH=y
