# SaviorOS kernel fragment: everything both architectures need that is not
# display, networking, Wi-Fi or hardening (those have their own fragments).
#
# Applied by Buildroot on top of the arch defconfig (x86_64_defconfig or
# i386_defconfig) in this order: common, <arch>, display, net, wifi,
# hardening. The normative list of symbols is required.txt next to this file;
# scripts/check-kconfig.sh checks it against the final .config.
#
# Rules: things needed before the modloop squashfs is mounted (initramfs,
# squashfs, loop, the boot medium's bus and filesystems, console) are built
# in (=y). Hardware drivers loaded by mdev coldplug are modules (=m) and live
# in /lib/modloop.sqfs.

# --- build ------------------------------------------------------------------
# The arch defconfigs set WERROR; a new compiler warning in a driver we enable
# must not break an image build.
# CONFIG_WERROR is not set
CONFIG_LOCALVERSION="-savior"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- base -------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_UNLOAD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# CONFIG_BINFMT_MISC is not set
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_DMIID=y

# --- cgroups and namespaces (task sandbox, DESIGN 6.5 and 12) ----------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# cpu.max needs CFS bandwidth control.
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
# CONFIG_CGROUP_DEBUG is not set
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# CONFIG_USER_NS is not set
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- memory, swap, modloop, firmware ----------------------------------------
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
# zram compression backends (Linux 6.12+; ignored by older kernels).
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- filesystems ------------------------------------------------------------
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_EXT4_FS=y
# BusyBox mke2fs makes ext2; ext4 mounts it.
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# Not needed on a RAM-only node.
# CONFIG_NFS_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_QUOTA is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_MD is not set

# --- boot storage: built in, the boot medium must appear without modules ----
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_SATA_AHCI=y
CONFIG_PATA_AMD=y
CONFIG_PATA_OLDPIIX=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
# Other chipsets' disk controllers and card readers: modules.
CONFIG_PATA_ALI=m
CONFIG_PATA_ATIIXP=m
CONFIG_PATA_SIS=m
CONFIG_PATA_VIA=m
CONFIG_SATA_NV=m
CONFIG_SATA_SIL=m
CONFIG_SATA_SIS=m
CONFIG_SATA_VIA=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
# CONFIG_USB_PRINTER is not set

# --- keyboard and console input ---------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_MACINTOSH_DRIVERS is not set

# --- ACPI, power, thermal, sensors, cpufreq ----------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_POWER_SUPPLY=y
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K8TEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_VIA_CPUTEMP=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_THINKPAD_ACPI=m
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_POWERNOW_K8=m
# p4-clockmod only throttles and makes things slower (DESIGN 13.3 blacklists it).
# CONFIG_X86_P4_CLOCKMOD is not set
CONFIG_CPU_IDLE=y
# CONFIG_HIBERNATION is not set
# CONFIG_PM_DEBUG is not set

# --- EFI --------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y

# --- size: things a swarm node never uses ------------------------------------
# CONFIG_SOUND is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_FTRACE is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_KALLSYMS_ALL is not set
