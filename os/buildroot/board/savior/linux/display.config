# SaviorOS kernel fragment: display (DESIGN 11). Firmware framebuffers are
# built in so /dev/fb0 exists at boot (simpledrm on BIOS VESA / UEFI GOP modes
# set by GRUB); KMS drivers are modules that replace it once mdev loads them.

CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
# Fallbacks for firmware framebuffers simple-framebuffer cannot describe.
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
# simplefb would compete with simpledrm for the same device.
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_VGA_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_WMI=m
CONFIG_ACPI_VIDEO=m
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PCSPKR=y

# KMS drivers (modules; firmware, where needed, comes from the modloop).
CONFIG_DRM_I915=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_GMA500=m
CONFIG_DRM_MGAG200=m
CONFIG_DRM_AST=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_QXL=m
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_AGP_AMD64=y
# Too new for this hardware class and huge (and amdgpu needs firmware we
# don't ship).
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_XE is not set

# No legacy fbdev hardware drivers: they fight with KMS and simpledrm.
# CONFIG_FB_SIS is not set
# CONFIG_FB_VIA is not set
# CONFIG_FB_SAVAGE is not set
# CONFIG_FB_RIVA is not set
# CONFIG_FB_NVIDIA is not set
# CONFIG_FB_RADEON is not set
# CONFIG_FB_ATY is not set
# CONFIG_FB_ATY128 is not set
# CONFIG_FB_MATROX is not set
# CONFIG_FB_I810 is not set
# CONFIG_FB_UVESA is not set
