# SaviorOS kernel fragment: i686 payload (Pentium Pro and later 32-bit CPUs,
# including CPUs without PAE or SSE2: Pentium M "Banias", Pentium III,
# Athlon XP, VIA C3-2, Geode LX).
# CONFIG_64BIT is not set
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_X86_GENERIC=y
# Up to 4 GiB of RAM without PAE: PAE-less CPUs must boot this kernel.
CONFIG_HIGHMEM4G=y
# CONFIG_HIGHMEM64G is not set
# CONFIG_X86_PAE is not set
CONFIG_NR_CPUS=8
CONFIG_CPU_MITIGATIONS=y
CONFIG_RANDOMIZE_BASE=y
# CONFIG_USELIB is not set
# 32-bit era cpufreq drivers (Pentium M, Athlon XP, VIA, ICH SpeedStep).
CONFIG_X86_SPEEDSTEP_CENTRINO=m
CONFIG_X86_POWERNOW_K7=m
CONFIG_X86_LONGHAUL=m
CONFIG_X86_E_POWERSAVER=m
CONFIG_X86_SPEEDSTEP_ICH=m
CONFIG_X86_SPEEDSTEP_SMI=m
