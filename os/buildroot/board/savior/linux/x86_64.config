# SaviorOS kernel fragment: x86_64 payload (any 64-bit x86 CPU).
CONFIG_64BIT=y
CONFIG_GENERIC_CPU=y
# 64-bit kernel booted by 32-bit UEFI firmware (Bay Trail, early Intel Macs).
CONFIG_EFI_MIXED=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# Every userspace program on the x86_64 payload is 64-bit, and the task
# seccomp filter kills compat syscalls anyway (DESIGN 6.5).
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
